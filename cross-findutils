# Package information:
: ${name:=findutils}
: ${version:=4.10.0}
: ${build:=0-pre1}
: ${dists:="findutils-${version}.tar.xz"}
: ${bdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

build() {
	tar -xvf "findutils-${version}.tar.xz"
	cd "findutils-${version}"

	./configure --prefix=/usr --host="$target" --build=`./build-aux/config.guess` --localstatedir=/var/lib/locate
	make -j "$jobs"
	make DESTDIR="$destdir" install
}
