# Package information:
: ${name:=ncurses}
: ${version:=6.6}
: ${build:=0-pre1}
: ${dists:="ncurses-${version}.tar.gz"}
: ${bdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

build() {
	tar -xvf "ncurses-${version}.tar.gz"
	cd "ncurses-${version}"

	./configure                          \
		--prefix=/usr                \
		--host="$target"             \
		--build=`./config.guess`     \
		--mandir=/usr/share/man      \
		--with-manpage-format=normal \
		--with-shared                \
		--without-normal             \
		--with-cxx-shared            \
		--without-debug              \
		--without-ada                \
		--disable-stripping

	make -j "$jobs"
	make DESTDIR="$destdir" install

	ln -svf libncursesw.so "${destdir}/usr/lib/libncurses.so"
	sed -e 's/^#if.*XOPEN.*$/#if 1/' -i "${destdir}/usr/include/curses.h"
}
