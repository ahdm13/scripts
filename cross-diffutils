# Package information:
: ${pkg_name:=diffutils}
: ${pkg_version:=3.12}
: ${pkg_build:=0-pre1}
: ${pkg_dist:="diffutils-${pkg_version}.tar.xz"}
: ${pkg_bdeps:=NIL}
: ${pkg_rdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

pkg_build() {
	tar -xvf "$pkg_dist"
	cd "diffutils-${pkg_version}"

	./configure --prefix=/usr --host="$target" gl_cv_func_strcasecmp_works=y --build=`./build-aux/config.guess`

	make -j "$jobs"
	make DESTDIR="$destdir" install
}
