# Package information:
: ${name:=diffutils}
: ${version:=3.12}
: ${build:=0-pre1}
: ${dists:="diffutils-${version}.tar.xz"}
: ${bdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

build() {
	tar -xvf "$dists"
	cd "diffutils-${version}"

	./configure --prefix=/usr --host="$target" gl_cv_func_strcasecmp_works=y --build=`./build-aux/config.guess`

	make -j "$jobs"
	make DESTDIR="$destdir" install
	rm -f "$destdir/usr/share/info/dir"
}
