# Package information:
: ${name:=zlib}
: ${version:=1.3.2}
: ${build:=1-main1}
: ${dists:="zlib-${version}.tar.gz"}
: ${bdeps:="binutils gcc glibc linux-headers make"}

# Environment variables:
: ${jobs:=1}

build() {
	tar -xvf "zlib-${version}.tar.gz"
	cd "zlib-${version}"

	./configure --prefix=/usr
	make -j "$jobs"
	make -j "$jobs" check
	make DESTDIR="$destdir" install
	rm -fv "$destdir/usr/lib/libz.a"
}
