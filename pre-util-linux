# Package information:
: ${name:=util-linux}
: ${version:=2.41.3}
: ${build:=0-pre1}
: ${dists:="util-linux-${version}.tar.xz"}
: ${bdeps:="base-files bash binutils gcc glibc linux-headers make ncurses texinfo"}

# Environment variables:
: ${jobs:=1}

build() {
	tar -xvf "util-linux-${version}.tar.xz"
	cd "util-linux-${version}"

	mkdir -pv "$destdir/var/lib/hwclock"
	touch "$destdir/var/lib/hwclock/.keep"
	./configure --libdir=/usr/lib     \
		--runstatedir=/run        \
		--disable-chfn-chsh       \
		--disable-login           \
		--disable-nologin         \
		--disable-su              \
		--disable-setpriv         \
		--disable-runuser         \
		--disable-pylibmount      \
		--disable-static          \
		--disable-liblastlog2     \
		--without-python          \
		ADJTIME_PATH=/var/lib/hwclock/adjtime \
		--docdir="/usr/share/doc/util-linux-${version}"

	make -j "$jobs"
	make DESTDIR="$destdir" install
}
