# Package information:
: ${pkg_name:=xz}
: ${pkg_version:=5.8.2}
: ${pkg_build:=0-pre1}
: ${pkg_dist:="xz-${pkg_version}.tar.xz"}
: ${pkg_bdeps:=NIL}
: ${pkg_rdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

pkg_build() {
	tar -xvf "xz-${pkg_version}.tar.xz"
	cd "xz-${pkg_version}"

	./configure --prefix=/usr --host="$target" --build=`./build-aux/config.guess` --disable-static --docdir="/usr/share/doc/xz-${pkg_version}"
	make -j "$jobs"
	make DESTDIR="$destdir" install

	rm -v "${destdir}/usr/lib/liblzma.la"
}
