# Package information:
: ${name:=xz}
: ${version:=5.8.2}
: ${build:=0-pre1}
: ${dists:="xz-${version}.tar.xz"}
: ${bdeps:=NIL}
: ${supports_destdir:=YES}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

build() {
	tar -xvf "xz-${version}.tar.xz"
	cd "xz-${version}"

	./configure --prefix=/usr --host="$target" --build=`./build-aux/config.guess` --disable-static --docdir="/usr/share/doc/xz-${version}"
	make -j "$jobs"
	make DESTDIR="$destdir" install

	rm -v "${destdir}/usr/lib/liblzma.la"
}
