# Package information:
: ${name:=readline}
: ${version:=8.3}
: ${build:=1-main1}
: ${dists:="readline-${version}.tar.gz"}
: ${bdeps:="binutils gcc glibc linux-headers make ncurses"}

# Environment variables:
: ${jobs:=1}

build() {
	tar -xvf "readline-${version}.tar.gz"
	cd "readline-${version}"

	sed -i '/MV.*old/d' Makefile.in
	sed -i '/{OLDSUFF}/c:' support/shlib-install
	sed -i 's/-Wl,-rpath,[^ ]*//' support/shobj-conf

	sed -e '270a\
     else\
       chars_avail = 1;'      \
    -e '288i\   result = -1;' \
    -i.orig input.c

	./configure              \
		--prefix=/usr    \
		--disable-static \
		--with-curses    \
		--docdir="/usr/share/doc/readline-${version}"

	make SHLIB_LIBS="-lncursesw" -j "$jobs"
	make DESTDIR="$destdir" install
}
