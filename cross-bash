# Package information:
: ${name:=bash}
: ${version:=5.3}
: ${build:=0-pre1}
: ${dists:="bash-${version}.tar.gz"}
: ${bdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

build() {
	tar -xvf "bash-${version}.tar.gz"
	cd "bash-${version}"

	./configure                                 \
		--prefix=/usr                       \
		--build=`sh ./support/config.guess` \
		--host="$target"                    \
		--without-bash-malloc

	make -j "$jobs"
	make DESTDIR="$destdir" install
	ln -sf "bash" "$destdir/usr/bin/sh"
}
