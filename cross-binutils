# Package information:
: ${name:=binutils}
: ${version:=2.46.0}
: ${build:=0-pre1}
: ${dists:="binutils-${version}.tar.xz"}
: ${bdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

build() {
	tar -xvf "binutils-${version}.tar.xz"
	cd "binutils-${version}"

	sed '6031s/$add_dir//' -i ltmain.sh

	mkdir -pv build
	cd build

	../configure                      \
		--prefix=/usr             \
		--build=`../config.guess` \
		--host="$target"          \
		--disable-nls             \
		--enable-shared           \
		--enable-gprofng=no       \
		--disable-werror          \
		--enable-64-bit-bfd       \
		--enable-new-dtags        \
		--enable-default-hash-style=gnu

	make -j "$jobs"
	make DESTDIR="$destdir" install
	rm -f "$destdir/usr/share/info/dir"

	rm -v "${destdir}/usr/lib/libbfd.a" "${destdir}/usr/lib/libbfd.la"
	rm -v "${destdir}/usr/lib/libctf.a" "${destdir}/usr/lib/libctf.la"
	rm -v "${destdir}/usr/lib/libctf-nobfd.a" "${destdir}/usr/lib/libctf-nobfd.la"
	rm -v "${destdir}/usr/lib/libopcodes.a" "${destdir}/usr/lib/libopcodes.la"
	rm -v "${destdir}/usr/lib/libsframe.a" "${destdir}/usr/lib/libsframe.la"
}
