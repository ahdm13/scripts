# Package information:
: ${name:=make}
: ${version:=4.4.1}
: ${build:=0-pre1}
: ${dists:="make-${version}.tar.gz"}
: ${bdeps:=NIL}
: ${supports_destdir:=YES}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

build() {
	tar -xvf "make-${version}.tar.gz"
	cd "make-${version}"

	./configure --prefix=/usr --host="$target" --build=`./build-aux/config.guess`
	make -j "$jobs"
	make DESTDIR="$destdir" install
}
