# Package information:
: ${pkg_name:=make}
: ${pkg_version:=4.4.1}
: ${pkg_build:=0-pre1}
: ${pkg_dist:="make-${pkg_version}.tar.gz"}
: ${pkg_bdeps:=NIL}
: ${pkg_rdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

pkg_build() {
	tar -xvf "make-${pkg_version}.tar.gz"
	cd "make-${pkg_version}"

	./configure --prefix=/usr --host="$target" --build=`./build-aux/config.guess`
	make -j "$jobs"
	make DESTDIR="$destdir" install
}
