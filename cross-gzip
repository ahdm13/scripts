# Package information:
: ${name:=gzip}
: ${version:=1.14}
: ${build:=0-pre1}
: ${dists:="gzip-${version}.tar.xz"}
: ${bdeps:=NIL}
: ${supports_destdir:=YES}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

build() {
	tar -xvf "gzip-${version}.tar.xz"
	cd "gzip-${version}"

	./configure --prefix=/usr --host="$target"
	make -j "$jobs"
	make DESTDIR="$destdir" install
}
