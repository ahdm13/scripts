# Package information:
: ${name:=libstdc++}
: ${version:=15.2.0}
: ${build:=0-pre1}

: ${dists="gcc-${version}.tar.xz"}
: ${bdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}
: ${sysroot:=/sysroot}

export PATH="${toolchain_dir}/bin:$PATH"

build() {
	tar -xvf "gcc-${version}.tar.xz"

	mkdir -pv "gcc-${version}/build"
	cd "gcc-${version}/build"

	../libstdc++-v3/configure                   \
		--host="$target"                    \
		--build=`../config.guess`           \
		--prefix=/usr                       \
		--disable-multilib                  \
		--disable-nls                       \
		--disable-libstdcxx-pch             \
		--with-gxx-include-dir=/gxx-include

	make -j "${jobs}"
	make DESTDIR="$destdir" install

	rm -rvf "${destdir}/gxx-include"
}
