# Package information:
: ${name:=linux-headers}
: ${version:=6.18.10}
: ${build:=1-main}
: ${dists:=linux-${version}.tar.xz}
: ${bdeps:=NIL}

# Environment variables:
: ${jobs:=1}

build() {
	tar -xvf "linux-${version}.tar.xz"
	cd "linux-${version}"

	make mrproper
	make clean

	make -j "$jobs" headers
	make INSTALL_HDR_PATH="${destdir}/usr" headers_install
}
