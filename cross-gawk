# Package information:
: ${pkg_name:=gawk}
: ${pkg_version:=5.3.2}
: ${pkg_build:=0-pre1}
: ${pkg_dist:="gawk-${pkg_version}.tar.xz"}
: ${pkg_bdeps:=NIL}
: ${pkg_rdeps:=NIL}

# Environment variables:
: ${jobs:=1}
: ${target:=x86_64-linux-gnu}
: ${toolchain_dir:="/usr/cross-${target}"}

export PATH="${toolchain_dir}/bin:$PATH"

pkg_build() {
	tar -xvf "gawk-${pkg_version}.tar.xz"
	cd "gawk-${pkg_version}"

	sed -i 's/extras//' Makefile.in
	./configure --prefix=/usr --host="$target" --build=`./build-aux/config.guess`

	make -j "$jobs"
	make DESTDIR="$destdir" install
}
